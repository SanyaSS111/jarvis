<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S. — установка" Width="980" Height="640" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift, Segoe UI" Foreground="#DCF2FB" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Acc" Color="#5CE1FF"/>
    <SolidColorBrush x:Key="Steel" Color="#7C9DB0"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#5CE1FF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="22,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#0D5CE1FF" BorderBrush="#805CE1FF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#335CE1FF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#5CE1FF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#405CE1FF" BorderBrush="#5CE1FF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#665CE1FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DCF2FB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="row" Background="#085CE1FF" BorderBrush="#245CE1FF" BorderThickness="1" Padding="12,9" Margin="0,0,0,7">
              <DockPanel>
                <Border x:Name="box" DockPanel.Dock="Left" Width="18" Height="18" BorderBrush="#995CE1FF" BorderThickness="1" Margin="0,2,12,0" VerticalAlignment="Top">
                  <Rectangle x:Name="mark" Fill="#5CE1FF" Margin="3" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="row" Property="Background" Value="#1A5CE1FF"/>
                <Setter TargetName="row" Property="BorderBrush" Value="#805CE1FF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="#5CE1FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="row" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#1A5CE1FF" BorderBrush="#4D5CE1FF" BorderThickness="1"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#5CE1FF">
                <Border.Effect><DropShadowEffect Color="#5CE1FF" BlurRadius="12" ShadowDepth="0"/></Border.Effect>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#665CE1FF" BorderThickness="1" CornerRadius="2">
    <Border.Background>
      <RadialGradientBrush Center="0.3,0.5" GradientOrigin="0.3,0.5" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#0B2230" Offset="0"/>
        <GradientStop Color="#03070A" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Grid>
      <!-- HUD grid -->
      <Rectangle IsHitTestVisible="False" Opacity="0.35">
        <Rectangle.Fill>
          <DrawingBrush TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <GeometryDrawing Geometry="M0,0 L44,0 M0,0 L0,44">
                <GeometryDrawing.Pen><Pen Brush="#205CE1FF" Thickness="1"/></GeometryDrawing.Pen>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- corner brackets -->
      <Path IsHitTestVisible="False" Stroke="#5CE1FF" StrokeThickness="2" Data="M8,30 L8,8 L30,8" />
      <Path IsHitTestVisible="False" Stroke="#5CE1FF" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Data="M22,0 L22,22 L0,22" />

      <Grid Margin="30,22,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- title bar -->
        <DockPanel x:Name="TitleBar" Background="Transparent" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="J . A . R . V . I . S ." FontSize="26" FontWeight="Bold" Foreground="#5CE1FF">
              <TextBlock.Effect><DropShadowEffect Color="#5CE1FF" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Subtitle" Text="УСТАНОВКА · JUST A RATHER VERY INTELLIGENT SYSTEM" FontSize="11" Foreground="#7C9DB0" Margin="2,2,0,0"/>
          </StackPanel>
          <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="✕" Padding="12,4" VerticalAlignment="Top"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- reactor -->
          <Grid x:Name="Reactor" Width="260" Height="260" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Ellipse Width="250" Height="250" Stroke="#335CE1FF" StrokeThickness="1" StrokeDashArray="2 6"/>
            <Ellipse x:Name="Ring1" Width="226" Height="226" Stroke="#5CE1FF" StrokeThickness="6" StrokeDashArray="6 30" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform x:Name="Rot1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="200" Height="200" Stroke="#265CE1FF" StrokeThickness="10"/>
            <Ellipse x:Name="Ring2" Width="170" Height="170" Stroke="#AA5CE1FF" StrokeThickness="12" StrokeDashArray="1.6 0.55" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform x:Name="Rot2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="112" Height="112" Stroke="#CC5CE1FF" StrokeThickness="3"/>
            <Ellipse x:Name="Ring3" Width="96" Height="96" Stroke="#805CE1FF" StrokeThickness="4" StrokeDashArray="4 2" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform x:Name="Rot3"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Core" Width="80" Height="80" RenderTransformOrigin="0.5,0.5">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="White" Offset="0"/>
                  <GradientStop Color="#5CE1FF" Offset="0.45"/>
                  <GradientStop Color="#005CE1FF" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
              <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale"/></Ellipse.RenderTransform>
              <Ellipse.Effect><DropShadowEffect Color="#5CE1FF" BlurRadius="40" ShadowDepth="0"/></Ellipse.Effect>
            </Ellipse>
            <Polygon Points="130,108 149,141 111,141" Stroke="#E6FFFFFF" StrokeThickness="2.5" Margin="0,0,0,0"/>
            <TextBlock x:Name="ReactorText" Text="" FontSize="13" Foreground="#5CE1FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-34"/>
          </Grid>

          <!-- pages -->
          <Grid Grid.Column="1" Margin="24,0,0,0">
            <!-- 1. welcome -->
            <DockPanel x:Name="PageWelcome">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="WelcomeNext" Style="{StaticResource Primary}" Content="ДАЛЕЕ  →"/>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="Greeting" Text="Добрый день." FontSize="30" Foreground="#5CE1FF"/>
                <TextBlock Margin="0,12,0,0" FontSize="15" LineHeight="22" Text="Этот мастер установит J.A.R.V.I.S. — ИИ-агента с голосом Джарвиса, локальные модели, обои HUD и оформление Windows. Вы сами выберете, что ставить. Всё скачивается с официальных источников и проверяется по контрольным суммам."/>
                <TextBlock Text="СКАНИРОВАНИЕ СИСТЕМЫ" FontSize="12" Foreground="#5CE1FF" Margin="0,26,0,8"/>
                <Border BorderBrush="#335CE1FF" BorderThickness="1" Background="#0A5CE1FF" Padding="14,10">
                  <StackPanel>
                    <TextBlock x:Name="HwGpu" FontSize="14" Text="Видеокарта: …"/>
                    <TextBlock x:Name="HwRam" FontSize="14" Margin="0,4,0,0" Text="Память: …"/>
                    <TextBlock x:Name="HwOs" FontSize="14" Margin="0,4,0,0" Text="Система: …"/>
                    <TextBlock x:Name="HwNote" FontSize="12" Margin="0,8,0,0" Foreground="#7C9DB0" Text=""/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>

            <!-- 2. components -->
            <DockPanel x:Name="PageComponents" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                  <Button x:Name="CompBack" Style="{StaticResource Btn}" Content="←  НАЗАД" Margin="0,0,10,0"/>
                  <Button x:Name="CompNext" Style="{StaticResource Primary}" Content="ДАЛЕЕ  →"/>
                </StackPanel>
                <TextBlock x:Name="SizeText" VerticalAlignment="Center" Foreground="#7C9DB0" FontSize="12"/>
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ЧТО УСТАНОВИТЬ" FontSize="12" Foreground="#5CE1FF" Margin="0,0,0,10"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CompList"/>
              </ScrollViewer>
            </DockPanel>

            <!-- 3. folder -->
            <DockPanel x:Name="PageFolder" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FolderBack" Style="{StaticResource Btn}" Content="←  НАЗАД" Margin="0,0,10,0"/>
                <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="УСТАНОВИТЬ"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="12" Foreground="#5CE1FF" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="ОБЗОР" Margin="10,0,0,0"/>
                  <TextBox x:Name="FolderBox" FontSize="15" Padding="10,8" Background="#0D5CE1FF" Foreground="#DCF2FB" BorderBrush="#805CE1FF" CaretBrush="#5CE1FF" Text="C:\JARVIS"/>
                </DockPanel>
                <TextBlock x:Name="FolderInfo" Margin="0,10,0,0" FontSize="13" Foreground="#7C9DB0"/>
                <CheckBox x:Name="ShortcutBox" Margin="0,22,0,0" IsChecked="True">
                  <TextBlock FontSize="14" Text="Ярлык J.A.R.V.I.S. на рабочем столе"/>
                </CheckBox>
                <Border Margin="0,14,0,0" BorderBrush="#5CFFB454" BorderThickness="2,0,0,0" Background="#0DFFB454" Padding="12,8">
                  <TextBlock FontSize="12.5" Foreground="#FFD9A6" Text="Ключ DeepSeek не входит в установку — после первого запуска агент попросит ваш собственный ключ (platform.deepseek.com). Локальные модели работают и без него."/>
                </Border>
              </StackPanel>
            </DockPanel>

            <!-- 4. progress -->
            <DockPanel x:Name="PageProgress" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="StepText" Text="Подготовка…" FontSize="18" Foreground="#5CE1FF"/>
                <TextBlock x:Name="StepDetail" Text="" FontSize="12.5" Foreground="#7C9DB0" Margin="0,4,0,10"/>
                <ProgressBar x:Name="Progress" Maximum="1000"/>
                <TextBlock x:Name="ProgressText" Text="" FontSize="12" Foreground="#7C9DB0" Margin="0,6,0,10"/>
              </StackPanel>
              <Border BorderBrush="#265CE1FF" BorderThickness="1" Background="#80000000">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11.5" Foreground="#9EC7D6" Margin="10,8" TextWrapping="Wrap"/>
                </ScrollViewer>
              </Border>
            </DockPanel>

            <!-- 5. done -->
            <DockPanel x:Name="PageDone" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DoneBtn" Style="{StaticResource Primary}" Content="ГОТОВО"/>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="DoneTitle" Text="Все системы в норме, сэр." FontSize="28" Foreground="#5CE1FF"/>
                <TextBlock x:Name="DoneText" Margin="0,12,0,0" FontSize="14" LineHeight="21"/>
                <CheckBox x:Name="LaunchBox" Margin="0,22,0,0" IsChecked="True">
                  <TextBlock FontSize="14" Text="Запустить J.A.R.V.I.S."/>
                </CheckBox>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
